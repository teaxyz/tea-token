    "prettier:check": "prettier --check \"{script,src,test}/**/*.{json,md,yml}\"",
    "prettier:write": "prettier --write \"{script,src,test}/**/*.{json,md,yml}\""
  },
  "dependencies": {
    "ethers": "^6.13.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
