  "version": "1.0.0",
  "author": {
    "name": "teaxyz",
    "url": "https://github.com/teaxyz"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "solhint-community": "^4.0.0"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "forge",
    "foundry",
    "smart-contracts",
    "solidity",
    "template"
  ],
  "private": true,
  "scripts": {
    "clean": "rm -rf cache out",
